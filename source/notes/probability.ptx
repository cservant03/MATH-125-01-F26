<?xml version="1.0" encoding="UTF-8"?>
<section xml:id="probability">
  <title>Probability</title>

  <subsection xml:id="basic-probability">
    <title>Basic Probability</title>

    <definition xml:id="def-outcome">
      <title>Outcome</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <definition xml:id="def-sample-space">
      <title>Sample Space</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <definition xml:id="def-event">
      <title>Event</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <definition xml:id="def-simple-event">
      <title>Simple Event</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <definition xml:id="def-compound-event">
      <title>Compound Event</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <assemblage xml:id="formula-basic-probability">
      <title>Probability with Equally Likely Outcomes</title>
      <p>
        For a finite sample space <m>S</m> with equally likely outcomes,
        <md>
          <mrow>P(E)=\dfrac{\text{number of outcomes in }E}{\text{total number of outcomes in }S}.</mrow>
        </md>
      </p>
      <p>
        <md>
          <mrow>0\le P(E)\le 1,\qquad P(\varnothing)=0,\qquad P(S)=1.</mrow>
        </md>
      </p>
    </assemblage>

    <example xml:id="ex-die-probabilities">
      <title>Rolling a Die</title>
      <p>
        A fair six-sided die is rolled once.
        <ol marker="a)">
          <li><p>List the sample space.</p></li>
          <li><p>Find the probability that the number showing is 5.</p></li>
          <li><p>Find the probability that the number showing is odd.</p></li>
          <li><p>Find the probability that the number showing is greater than 3.</p></li>
          <li><p>Find the probability that the number showing is greater than 6.</p></li>
          <li><p>Find the probability that the number showing is less than 7.</p></li>
          <li><p>Identify a simple event and a compound event from the preceding parts.</p></li>
        </ol>
      </p>
    </example>

    <example xml:id="ex-visitor-survey">
      <title>Museum Visitor Survey</title>
      <p>
        Museum visitors were asked whether they had visited an art museum during the previous year.
        There were 137 <q>yes</q> responses and 86 <q>no</q> responses.
        One of these visitors is selected uniformly at random.
        <ol marker="a)">
          <li><p>Find the probability that the visitor answered <q>yes</q>. Give an exact fraction and a decimal rounded to three decimal places.</p></li>
          <li><p>Find the probability that the visitor answered <q>no</q>. Give the answer as a percent rounded to one decimal place.</p></li>
        </ol>
      </p>
    </example>

    <example xml:id="ex-probability-denominator">
      <title>Checking a Probability Calculation</title>
      <p>
        An art studio has 7 blue markers and 11 black markers in a box.
        A student selects one marker uniformly at random and claims that the probability of selecting a blue marker is
        <m>\dfrac{7}{11}</m>.
        <ol marker="a)">
          <li><p>Is the student's probability correct? Give the correct probability and explain what the numerator and denominator count.</p></li>
          <li><p>A classmate says the student's answer must be correct because it is between 0 and 1. Does this establish that the answer is correct? Explain.</p></li>
          <li><p>Another classmate says that every probability must be written with a denominator of 100. Is that claim correct? Explain.</p></li>
        </ol>
      </p>
    </example>
  </subsection>

  <subsection xml:id="tables-and-complements">
    <title>Probability from Tables and Complements</title>

    <example xml:id="ex-museum-table">
      <title>Art Museum Preferences</title>
      <p>
        Visitors at an art museum each selected one favorite type of exhibit.
        Their choices and the times of their visits are summarized in <xref ref="museum-preferences"/>.
        One of the surveyed visitors is selected uniformly at random.
      </p>
      <table xml:id="museum-preferences">
        <title>Favorite Exhibit by Visit Time</title>
        <tabular row-headers="yes" halign="center" valign="middle"
                 top="medium" left="medium" bottom="medium" right="medium">
          <row header="yes" bottom="medium">
            <cell>Visit time</cell>
            <cell>Paintings</cell>
            <cell>Photographs</cell>
            <cell>Sculptures</cell>
            <cell>Total</cell>
          </row>
          <row>
            <cell>Morning</cell>
            <cell>20</cell>
            <cell>12</cell>
            <cell>8</cell>
            <cell>40</cell>
          </row>
          <row bottom="medium">
            <cell>Afternoon</cell>
            <cell>8</cell>
            <cell>16</cell>
            <cell>6</cell>
            <cell>30</cell>
          </row>
          <row>
            <cell>Total</cell>
            <cell>28</cell>
            <cell>28</cell>
            <cell>14</cell>
            <cell>70</cell>
          </row>
        </tabular>
      </table>
      <p>
        Give each probability as a simplified fraction.
        <ol marker="a)">
          <li><p>Find the probability that the visitor preferred photographs.</p></li>
          <li><p>Find the probability that the visitor came in the afternoon.</p></li>
          <li><p>Find the probability that the visitor preferred sculptures.</p></li>
        </ol>
      </p>
    </example>

    <definition xml:id="def-complement">
      <title>Complement</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <assemblage xml:id="formula-complement">
      <title>Complement Rule</title>
      <p>
        The complement of <m>A</m> is denoted by <m>A^c</m>.
        <md>
          <mrow>P(A^c)=1-P(A).</mrow>
        </md>
      </p>
    </assemblage>

    <example xml:id="ex-complement">
      <title>Using a Complement</title>
      <p>
        Use <xref ref="museum-preferences"/>. One visitor is selected uniformly at random.
        <ol marker="a)">
          <li><p>Find the probability that the visitor did not prefer sculptures.</p></li>
          <li><p>Find the probability that the visitor did not come in the afternoon.</p></li>
          <li><p>Check the answer to part (a) by adding the counts in the other exhibit categories.</p></li>
        </ol>
      </p>
    </example>
  </subsection>

  <subsection xml:id="combining-events">
    <title>And and Or</title>

    <definition xml:id="def-intersection">
      <title>Intersection</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <example xml:id="ex-intersection">
      <title>Combining a Visit Time and a Preference</title>
      <p>
        Use <xref ref="museum-preferences"/>. One visitor is selected uniformly at random.
        <ol marker="a)">
          <li><p>Find the probability that the visitor came in the afternoon and preferred photographs.</p></li>
          <li><p>Find the probability that the visitor came in the morning and preferred sculptures.</p></li>
        </ol>
      </p>
    </example>

    <definition xml:id="def-union">
      <title>Union</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <definition xml:id="def-mutually-exclusive">
      <title>Mutually Exclusive Events</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <assemblage xml:id="formula-addition">
      <title>Addition Rule</title>
      <p>
        <md>
          <mrow>P(A\text{ or }B)=P(A\cup B)=P(A)+P(B)-P(A\cap B).</mrow>
        </md>
      </p>
      <p>
        For mutually exclusive events,
        <md>
          <mrow>P(A\text{ or }B)=P(A)+P(B).</mrow>
        </md>
      </p>
    </assemblage>

    <example xml:id="ex-union">
      <title>At Least One of Two Events</title>
      <p>
        Use <xref ref="museum-preferences"/>. One visitor is selected uniformly at random.
        <ol marker="a)">
          <li><p>Find the probability that the visitor came in the morning or preferred photographs.</p></li>
          <li><p>Find the probability that the visitor preferred photographs or sculptures.</p></li>
        </ol>
      </p>
    </example>

    <example xml:id="ex-union-with-complement">
      <title>Library Cards and Writing Workshops</title>
      <p>
        A community library recorded whether each surveyed visitor has a library card and
        whether the visitor attended a writing workshop. Each visitor appears once in the table.
        One surveyed visitor is selected uniformly at random.
      </p>
      <table xml:id="library-workshop">
        <title>Library Card Status and Workshop Attendance</title>
        <tabular row-headers="yes" halign="center" valign="middle"
                 top="medium" left="medium" bottom="medium" right="medium">
          <row header="yes" bottom="medium">
            <cell>Has a library card</cell>
            <cell>Attended workshop</cell>
            <cell>Did not attend workshop</cell>
          </row>
          <row>
            <cell>Yes</cell>
            <cell>38</cell>
            <cell>97</cell>
          </row>
          <row>
            <cell>No</cell>
            <cell>26</cell>
            <cell>54</cell>
          </row>
        </tabular>
      </table>
      <p>
        <ol marker="a)">
          <li><p>How many visitors are represented in the table?</p></li>
          <li><p>Find the probability that the visitor attended the workshop or does not have a library card. Give the answer as a percent rounded to one decimal place.</p></li>
          <li><p>Find the probability that the visitor has a library card and did not attend the workshop. Give the answer as a simplified fraction.</p></li>
        </ol>
      </p>
    </example>
  </subsection>

  <subsection xml:id="conditional-probability">
    <title>Conditional Probability</title>

    <definition xml:id="def-conditional-probability">
      <title>Conditional Probability</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <assemblage xml:id="formula-conditional">
      <title>Conditional Probability Formula</title>
      <p>
        Read <m>P(B\mid A)</m> as <q>the probability of <m>B</m> given <m>A</m>.</q>
        If <m>P(A)>0</m>, then
        <md>
          <mrow>P(B\mid A)=\dfrac{P(A\cap B)}{P(A)}.</mrow>
        </md>
      </p>
    </assemblage>

    <example xml:id="ex-conditional">
      <title>Changing the Group Being Considered</title>
      <p>
        Use <xref ref="museum-preferences"/>.
        Give each probability as a simplified fraction.
        <ol marker="a)">
          <li><p>Find the probability that a randomly selected visitor came in the afternoon, given that the visitor preferred photographs.</p></li>
          <li><p>Find the probability that a randomly selected visitor preferred photographs, given that the visitor came in the afternoon.</p></li>
          <li><p>Find the probability that a randomly selected visitor came in the afternoon and preferred photographs.</p></li>
        </ol>
      </p>
    </example>
  </subsection>

  <subsection xml:id="independence">
    <title>Independent and Dependent Events</title>

    <definition xml:id="def-independent">
      <title>Independent Events</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <definition xml:id="def-dependent">
      <title>Dependent Events</title>
      <statement>
        <p/>
      </statement>
    </definition>

    <example xml:id="ex-identifying-independence">
      <title>Identifying Independence</title>
      <p>
        For each pair of events, determine whether the events are independent or dependent. Explain.
        <ol marker="a)">
          <li><p>A fair coin is tossed twice. The events are getting heads on the first toss and getting heads on the second toss.</p></li>
          <li><p>One of 10 thoroughly mixed cards, including 4 comedy prompts, is selected at random and set aside. A second card is selected at random. The events are selecting comedy on the first draw and selecting comedy on the second draw.</p></li>
          <li><p>The card selection in part (b) is repeated, this time returning the first card and mixing the cards before the second draw. The events are again selecting comedy on the first draw and selecting comedy on the second draw.</p></li>
        </ol>
      </p>
    </example>

    <assemblage xml:id="formula-independent">
      <title>Multiplication Rule for Independent Events</title>
      <p>
        For independent events <m>A</m> and <m>B</m>,
        <md>
          <mrow>P(A\text{ and }B)=P(A)\cdot P(B).</mrow>
        </md>
      </p>
    </assemblage>

    <example xml:id="ex-two-rolls">
      <title>Two Rolls of a Die</title>
      <p>
        A fair six-sided die is rolled twice, with independent results.
        <ol marker="a)">
          <li><p>Find the probability of rolling a 4 on the first roll and a number greater than 4 on the second roll.</p></li>
          <li><p>Find the probability of rolling an odd number on the first roll and an even number on the second roll.</p></li>
        </ol>
      </p>
    </example>

    <example xml:id="ex-with-replacement">
      <title>Theater Prompts with Replacement</title>
      <p>
        An improv team has 4 comedy prompt cards, 6 drama prompt cards, 5 mystery prompt cards,
        and 3 musical prompt cards. A card is drawn at random, returned to the stack, and thoroughly mixed
        with the other cards before a second card is drawn at random.
        <ol marker="a)">
          <li><p>Find the probability that the first card is comedy and the second card is musical.</p></li>
          <li><p>Find the probability that both cards are mystery prompts.</p></li>
        </ol>
      </p>
    </example>

    <assemblage xml:id="formula-general-multiplication">
      <title>General Multiplication Rule</title>
      <p>
        If <m>P(A)>0</m>, then
        <md>
          <mrow>P(A\text{ and }B)=P(A)\cdot P(B\mid A).</mrow>
        </md>
      </p>
    </assemblage>

    <example xml:id="ex-without-replacement">
      <title>Literary Showcase without Replacement</title>
      <p>
        A literary showcase received 6 poems, 8 short stories, 5 essays, and 7 plays.
        An editor selects one submission uniformly at random and sets it aside,
        then selects a second submission uniformly at random from those remaining.
        <ol marker="a)">
          <li><p>Find the probability that the first selection is an essay and the second selection is a poem. Give an exact fraction and a decimal rounded to four decimal places.</p></li>
          <li><p>Find the probability that both selections are short stories.</p></li>
          <li><p>Find the probability of selecting one essay and one poem, in either order.</p></li>
          <li><p>For each part, explain how the first selection affects the counts used for the second selection.</p></li>
        </ol>
      </p>
    </example>
  </subsection>
</section>
