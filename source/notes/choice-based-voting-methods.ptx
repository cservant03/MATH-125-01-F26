                        <cell></cell>
                        <cell>X</cell>
                        <cell></cell>
                        <cell></cell>
                    </row>
                    <row>
                        <cell>Bicycle-repair station (B)</cell>
                        <cell>X</cell>
                        <cell>X</cell>
                        <cell></cell>
                        <cell></cell>
                        <cell></cell>
                    </row>
                    <row>
                        <cell>Covered pavilion (C)</cell>
                        <cell></cell>
                        <cell>X</cell>
                        <cell>X</cell>
                        <cell>X</cell>
                        <cell>X</cell>
                    </row>
                    <row>
                        <cell>Dog area (D)</cell>
                        <cell>X</cell>
                        <cell></cell>
                        <cell></cell>
                        <cell>X</cell>
                        <cell>X</cell>
                    </row>
                    <row>
                        <cell>Exercise stations (E)</cell>
                        <cell></cell>
                        <cell></cell>
                        <cell>X</cell>
                        <cell>X</cell>
                        <cell></cell>
                    </row>
                    <row>
                        <cell>Fountain (F)</cell>
                        <cell></cell>
                        <cell>X</cell>
                        <cell></cell>
                        <cell></cell>
