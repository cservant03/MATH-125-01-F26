<?xml version="1.0" encoding="UTF-8"?>
<section xml:id="sec-graphs-vocabulary-representations">
  <title>Notes: Graphs Vocabulary and Representations</title>

  <objectives>
    <ul>
      <li><p>Translate a real situation into a graph.</p></li>
      <li><p>Identify vertices, edges, loops, degrees, paths, circuits, and connected graphs.</p></li>
      <li><p>Explain why the drawing of a graph may change while its connections remain the same.</p></li>
    </ul>
  </objectives>

